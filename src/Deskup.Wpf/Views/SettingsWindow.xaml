<Window x:Class="Deskup.Wpf.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 - Deskup" Width="440" Height="340" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="默认保存根目录（分区文件的存放位置）" FontWeight="Bold"/>
        <DockPanel Margin="0,4,0,8">
            <Button x:Name="BtnBrowse" Content="浏览" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,2"/>
            <TextBox x:Name="TxtRoot"/>
        </DockPanel>

        <CheckBox x:Name="ChkMove" Content="拖入分区时移动文件（取消则仅复制，不移动原桌面文件）" Margin="0,4"/>
        <CheckBox x:Name="ChkStart" Content="开机自启" Margin="0,4"/>
        <CheckBox x:Name="ChkHideIcons" Content="隐藏系统桌面图标" Margin="0,4"/>

        <TextBlock Text="桌面图层模式" FontWeight="Bold" Margin="0,8,0,4"/>
        <ComboBox x:Name="CmbLayer">
            <ComboBoxItem Content="置顶覆盖（推荐，稳定）" Tag="Overlay"/>
            <ComboBoxItem Content="置于桌面图标之下（实验性）" Tag="BehindIcons"/>
        </ComboBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="BtnOK" Content="确定" Width="80" Margin="6" Padding="6,2"/>
            <Button x:Name="BtnCancel" Content="取消" Width="80" Margin="6" Padding="6,2"/>
        </StackPanel>
    </StackPanel>
</Window>
