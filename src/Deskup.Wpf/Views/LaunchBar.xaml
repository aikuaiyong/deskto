<Window x:Class="Deskup.Wpf.Views.LaunchBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize"
        Height="74">
    <Border Background="#222222" CornerRadius="0,0,8,8" Opacity="0.85">
        <Grid Margin="8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnPin" Grid.Column="0" Content="📌" Width="36" Height="36"
                    Background="#444444" BorderThickness="0" Foreground="White" ToolTip="固定/自动隐藏"
                    VerticalAlignment="Center"/>
            <StackPanel x:Name="Items" Grid.Column="1" Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Button x:Name="BtnAdd" Grid.Column="2" Content="＋" Width="36" Height="36"
                    Background="#444444" BorderThickness="0" Foreground="White" ToolTip="添加快捷方式"
                    VerticalAlignment="Center"/>
        </Grid>
    </Border>
</Window>
