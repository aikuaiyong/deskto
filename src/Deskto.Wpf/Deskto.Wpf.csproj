<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>deskto</AssemblyName>
    <ApplicationIcon>Deskto.ico</ApplicationIcon>
    <RootNamespace>Deskto.Wpf</RootNamespace>
    <AssemblyVersion>2.1.3.0</AssemblyVersion>
    <FileVersion>2.1.3.0</FileVersion>
    <Version>2.1.3</Version>
    <!-- 默认产出「轻量便携版」：只有几 MB，解压即用（需目标机装 .NET 8 桌面运行时）。
         如需「免安装环境」的完整版，用命令行覆盖：
         dotnet publish -r win-x64 -p:SelfContained=true -p:PublishSingleFile=false -->
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- 若你的环境是 .NET 9，把上方 TargetFramework 改为 net9.0-windows 即可 -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Deskto.Core\Deskto.Core.csproj" />
    <PackageReference Include="Emoji.Wpf" Version="0.3.4" />
    <!-- 播放动画背景：支持 GIF 与 APNG（WpfAnimatedGif 作者的演进版，纯托管） -->
    <PackageReference Include="AnimatedImage.Wpf" Version="2.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- 同时开启 UseWPF 与 UseWindowsForms 时，SDK 会全局引入 System.Windows.Forms，
         与 System.Windows 下的同名类型（Application/Color/DragEventArgs/KeyEventArgs 等）
         冲突。本项目仅在 TrayIcon.cs 用到 Forms，故移除此全局 using，由该文件自行 using。 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
