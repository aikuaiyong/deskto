<Window x:Class="Deskto.Wpf.Views.PartitionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 分区标题区：右键弹出设置菜单 -->
        <Border x:Name="TitleBar" Grid.Row="0" CornerRadius="9,9,0,0" MinHeight="30"
                Background="#3A6EA5" MouseLeftButtonDown="TitleBar_MouseDown"
                MouseRightButtonDown="TitleBar_RightClick">
            <Grid>
                <emoji:TextBlock x:Name="TitleText" VerticalAlignment="Center" Margin="10,0,0,0"
                           Foreground="White" FontWeight="Bold" FontSize="13"
                           MouseLeftButtonDown="TitleText_MouseDown"/>
                <TextBox x:Name="TitleEdit" VerticalAlignment="Center" Margin="8,2"
                         Visibility="Collapsed" KeyDown="TitleEdit_KeyDown" LostFocus="TitleEdit_Lost"
                         HorizontalAlignment="Stretch" TextAlignment="Left" Background="#FFFFFF"
                         Foreground="#000000" BorderThickness="1" BorderBrush="#3A6EA5" FontSize="13" FontWeight="Bold"/>
            </Grid>
        </Border>

        <!-- 分区内容区：纯背景色块，独立透明度（锁定后点击穿透，不影响桌面操作） -->
        <Border x:Name="ContentArea" Grid.Row="1" CornerRadius="0,0,9,9"
                Background="#FFFFFF">
            <Grid>
                <ContentPresenter x:Name="ContentHost"/>
                <!-- 调整大小角标：两条 45° 斜线表示可拖拽 -->
                <Grid x:Name="ResizeGrip" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Cursor="SizeNWSE" Background="Transparent"
                      MouseDown="ResizeGrip_MouseDown" MouseMove="ResizeGrip_MouseMove" MouseUp="ResizeGrip_MouseUp">
                    <Path Stroke="#999" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                        <Path.Data>
                            <GeometryGroup>
                                <LineGeometry StartPoint="12,2" EndPoint="2,12"/>
                                <LineGeometry StartPoint="12,8" EndPoint="8,12"/>
                            </GeometryGroup>
                        </Path.Data>
                    </Path>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
